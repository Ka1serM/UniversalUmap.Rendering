<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:UniversalUmap.Rendering.Controls"
             x:Class="UniversalUmap.Rendering.Controls.RenderModeSwitcher"
             x:DataType="controls:RenderModeSwitcher">
    <UserControl.Styles>
        <Style Selector="Border.renderModeShell">
            <Setter Property="CornerRadius" Value="{StaticResource radius-md}" />
            <Setter Property="BoxShadow" Value="{StaticResource shadow-surface-rest}" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Transitions">
                <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.12" Easing="QuadraticEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.renderModeShellContent">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
        </Style>
        <Style Selector="Button.renderModeSegment">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MaxWidth" Value="30" />
            <Setter Property="MaxHeight" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource radius-md}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.16" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.renderModeSegment:pointerover">
            <Setter Property="Background" Value="{DynamicResource OverlaySoft}" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
        </Style>
        <Style Selector="Button.renderModeSegment.selected">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForeground}" />
        </Style>
        <Style Selector="Button.renderModeSegment.selected:pointerover">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForeground}" />
        </Style>
        <Style Selector="Button.renderModeSegment.selected:pressed">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForeground}" />
        </Style>
        <Style Selector="Border.renderModeSegmentDivider">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="Background" Value="{DynamicResource Border}" />
        </Style>
    </UserControl.Styles>
    <Border x:Name="Shell" Classes="renderModeShell">
        <Border x:Name="ShellContent" Classes="renderModeShellContent"
                ClipToBounds="True"
                Padding="3">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto">
                <Button x:Name="AoButton"
                        Grid.Column="0"
                        Classes="renderModeSegment"
                        Click="AoButton_OnClick"
                        ToolTip.Tip="Ambient Occlusion">
                    <Viewbox Width="16" Height="16">
                        <Canvas Width="16" Height="16">
                            <Ellipse Width="14" Height="14" Canvas.Left="1" Canvas.Top="1"
                                     Stroke="{Binding $parent[Button].Foreground}"
                                     StrokeThickness="1.2" />
                            <Path Data="M4,8 C4.6,4.8 7.4,3 10.5,3 C11.7,3 12.8,3.3 13.8,3.8"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="1" />
                            <Path Data="M3.5,9.5 C4.3,11.5 6.3,13 8.7,13.3"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="1"
                                  Opacity="0.85" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <Border Grid.Column="1" Classes="renderModeSegmentDivider" />

                <Button x:Name="DirectLightingButton"
                        Grid.Column="2"
                        Classes="renderModeSegment"
                        Click="DirectLightingButton_OnClick"
                        ToolTip.Tip="Direct Lighting">
                    <Viewbox Width="16" Height="16">
                        <Canvas Width="16" Height="16">
                            <Ellipse Width="14" Height="14" Canvas.Left="1" Canvas.Top="1"
                                     Stroke="{Binding $parent[Button].Foreground}"
                                     StrokeThickness="1.2" />
                            <Path Data="M3.7,10.5 C6.1,10 7.2,8.3 8,6.8 C8.8,5.3 10,3.9 13,3.3"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="1" />
                            <Path Data="M3.4,7.9 C5.3,7.4 6.5,6.4 7.4,4.9"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="1"
                                  Opacity="0.8" />
                            <Path Data="M8,12.2 C9.7,11.5 10.8,10.4 12.2,8.2 C12.7,7.3 13.5,6.6 14.2,6.2"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="1"
                                  Opacity="0.9" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <Border Grid.Column="3" Classes="renderModeSegmentDivider" />

                <Button x:Name="PathTracingButton"
                        Grid.Column="4"
                        Classes="renderModeSegment"
                        Click="PathTracingButton_OnClick"
                        ToolTip.Tip="Path Tracing">
                    <Viewbox Width="16" Height="16">
                        <Canvas Width="16" Height="16">
                            <Ellipse Width="14" Height="14" Canvas.Left="1" Canvas.Top="1"
                                     Stroke="{Binding $parent[Button].Foreground}"
                                     StrokeThickness="1.2" />
                            <Path Data="M4.2,5 C6.1,3.4 8.9,2.8 11.4,3.6 C13.5,4.3 14.6,5.6 14.8,7"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="1" />
                            <Path Data="M4.6,11.5 C6.1,12.7 8,13.3 10.2,13.1 C12.8,12.8 14.7,11.2 15,8.8"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="1"
                                  Opacity="0.9" />
                            <Path Data="M7.6,4.7 C8.9,5.7 9.8,6.8 10.2,8.2"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="1"
                                  Opacity="0.75" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>
    </Border>
</UserControl>
