<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UniversalUmap.Rendering.Controls.ObjectReferenceControl"
             x:CompileBindings="False">
    <Grid ColumnDefinitions="32,*" ColumnSpacing="8" VerticalAlignment="Center">
        <Border Grid.Column="0" Width="32" Height="32"
                CornerRadius="{StaticResource radius-sm}"
                Background="{DynamicResource OverlaySoft}"
                ClipToBounds="True">
            <Grid RowDefinitions="*,3">
                <TextBlock x:Name="GlyphText" Grid.Row="0"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="13" FontWeight="Bold" />
                <Border x:Name="AccentBar" Grid.Row="1" />
            </Grid>
        </Border>

        <Border Grid.Column="1" Height="32"
                CornerRadius="{StaticResource radius-sm}"
                Background="{DynamicResource OverlaySoft}"
                BorderThickness="1" BorderBrush="{DynamicResource Border}"
                Padding="8,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="NameText" Grid.Column="0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="&#9662;" Opacity="0.6"
                           VerticalAlignment="Center" Margin="6,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
