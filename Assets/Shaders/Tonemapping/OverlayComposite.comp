#version 460

#include "../SharedStructs.h"
#include "Agx.glsl"

layout(local_size_x = GROUP_SIZE, local_size_y = GROUP_SIZE) in;

layout(binding = 0, rgba32f) readonly uniform image2D inputColorImage;
layout(binding = 1, r32ui) readonly uniform uimage2D inputCryptoImage;
layout(binding = 2, rgba16f) readonly uniform image2D inputPositionImage;
layout(binding = 3, rgba8) writeonly uniform image2D outputImage;

layout(push_constant) uniform OverlayPushConstants {
    uint selectedInstanceId;
} pc;

ivec2 toPickPixel(ivec2 outputPixel, ivec2 outputSize) {
    return ivec2(outputPixel.x, (outputSize.y - 1) - outputPixel.y);
}

bool isSelectedHit(ivec2 outputPixel, ivec2 outputSize) {
    if (outputPixel.x < 0 || outputPixel.y < 0 || outputPixel.x >= outputSize.x || outputPixel.y >= outputSize.y)
        return false;

    ivec2 pickPixel = toPickPixel(outputPixel, outputSize);
    uint cryptoId = imageLoad(inputCryptoImage, pickPixel).x;
    if (cryptoId != pc.selectedInstanceId)
        return false;

    vec4 packedPosition = imageLoad(inputPositionImage, pickPixel);
    return packedPosition.w > 0.5;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputSize = imageSize(outputImage);
    if (pixel.x >= outputSize.x || pixel.y >= outputSize.y)
        return;

    vec4 hdrImage = imageLoad(inputColorImage, pixel);

    vec3 color = agxPunchy(hdrImage.rgb);
    if (pc.selectedInstanceId == INVALID_INSTANCE) {
        imageStore(outputImage, pixel, vec4(color, hdrImage.a));
        return;
    }

    bool centerSelected = isSelectedHit(pixel, outputSize);
    bool edge = false;
    const int outlineRadius = 2;
    for (int y = -outlineRadius; y <= outlineRadius && !edge; ++y) {
        for (int x = -outlineRadius; x <= outlineRadius; ++x) {
            if (x == 0 && y == 0)
                continue;
            bool neighborSelected = isSelectedHit(pixel + ivec2(x, y), outputSize);
            if (neighborSelected != centerSelected) {
                edge = true;
                break;
            }
        }
    }

    if (edge) {
        const vec3 outlineColor = vec3(1.0, 0.78, 0.12);
        const float outlineStrength = 0.9;
        color = mix(color, outlineColor, outlineStrength);
    }

    imageStore(outputImage, pixel, vec4(color, hdrImage.a));
}
