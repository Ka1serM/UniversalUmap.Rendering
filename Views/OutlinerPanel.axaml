<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:icons="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             xmlns:scenes="clr-namespace:UniversalUmap.Rendering.Scenes;assembly=UniversalUmap.Rendering"
             xmlns:viewModels="clr-namespace:UniversalUmap.Rendering.ViewModels;assembly=UniversalUmap.Rendering"
             x:Class="UniversalUmap.Rendering.Views.OutlinerPanel"
             x:DataType="viewModels:OutlinerPanelViewModel">
    <UserControl.Styles>
        <Style Selector="TreeView.outlinerTree ToggleButton">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Width" Value="0" />
            <Setter Property="Height" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="TreeView.outlinerTree Border.finderTreeChevron">
            <Setter Property="Width" Value="{StaticResource tree-chevron-size}" />
            <Setter Property="Height" Value="{StaticResource tree-chevron-size}" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TreeView.outlinerTree Grid.finderTreeChevronHost">
            <Setter Property="Width" Value="{StaticResource tree-chevron-size}" />
            <Setter Property="Height" Value="{StaticResource tree-chevron-size}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TreeView.outlinerTree icons|SymbolIcon.finderTreeChevronIcon">
            <Setter Property="FontSize" Value="{StaticResource tree-chevron-font-size}" />
            <Setter Property="Opacity" Value="0.9" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <TreeView x:Name="OutlinerTreeView"
                  Classes="outlinerTree"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  AutoScrollToSelectedItem="True">
            <TreeView.ItemContainerTheme>
                <ControlTheme TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}"
                              x:DataType="scenes:SceneHierarchyNode">
                    <Setter Property="IsSelected" Value="{Binding IsSelected}" />
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </ControlTheme>
            </TreeView.ItemContainerTheme>
            <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="scenes:SceneHierarchyNode"
                                  ItemsSource="{Binding Children}">
                    <Grid ColumnDefinitions="Auto,Auto,*">
                        <Border Grid.Column="0"
                                Classes="finderTreeChevron"
                                Opacity="{Binding HasChildren, Converter={StaticResource BoolToOpacity}}">
                            <Grid Classes="finderTreeChevronHost"
                                  RenderTransformOrigin="50%,50%">
                                <Grid.RenderTransform>
                                    <RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource BoolToAngle}, ConverterParameter=90}">
                                        <RotateTransform.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Angle"
                                                                  Duration="0:0:0.18"
                                                                  Easing="QuadraticEaseInOut" />
                                            </Transitions>
                                        </RotateTransform.Transitions>
                                    </RotateTransform>
                                </Grid.RenderTransform>
                                <icons:SymbolIcon Classes="finderTreeChevronIcon"
                                                  Symbol="ChevronRight" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="1"
                                Classes="treeIcon">
                            <icons:SymbolIcon Classes="treeIcon"
                                              Symbol="{Binding Kind, Converter={StaticResource SceneNodeKindToSymbol}}" />
                        </Border>
                        <StackPanel Grid.Column="2" Spacing="1">
                            <TextBlock Classes="treeName"
                                       Text="{Binding Name}" />
                            <TextBlock Classes="treeSubtitle"
                                       Text="{Binding Subtitle}" />
                        </StackPanel>
                    </Grid>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <TextBlock Classes="emptyState"
                   IsVisible="{Binding IsSceneEmpty}"
                   Text="Scene empty" />
    </Grid>
</UserControl>
