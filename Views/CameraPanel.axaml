<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:UniversalUmap.Rendering.ViewModels;assembly=UniversalUmap.Rendering"
             xmlns:cameras="clr-namespace:UniversalUmap.Rendering.Views.Cameras;assembly=UniversalUmap.Rendering"
             x:Class="UniversalUmap.Rendering.Views.CameraPanel"
             x:DataType="viewModels:CameraPanelViewModel"
             x:CompileBindings="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel HorizontalAlignment="Stretch" Spacing="12">

            <StackPanel Spacing="3">
                <TextBlock Classes="renderLabel" Text="Projection" />
                <ComboBox ItemsSource="{Binding ProjectionTypes}"
                          SelectedItem="{Binding SelectedProjection}" />
            </StackPanel>

            <StackPanel Spacing="3">
                <TextBlock Classes="renderLabel" Text="Field of View" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <Slider Grid.Column="0" Minimum="1" Maximum="179" TickFrequency="1" HorizontalAlignment="Stretch"
                            Value="{Binding Model.Settings.FieldOfView, Mode=TwoWay}" />
                    <TextBlock Grid.Column="1" FontSize="14" HorizontalAlignment="Right" TextAlignment="Right"
                               Padding="4,0,0,0"
                               Text="{Binding Model.Settings.FieldOfView, StringFormat={}{0:0.0}°}" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="3">
                <TextBlock Classes="renderLabel" Text="Focal Length" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <Slider Grid.Column="0" Minimum="8" Maximum="200" TickFrequency="1" HorizontalAlignment="Stretch"
                            Value="{Binding Model.Settings.FocalLengthMm, Mode=TwoWay}" />
                    <TextBlock Grid.Column="1" FontSize="14" HorizontalAlignment="Right" TextAlignment="Right"
                               Padding="4,0,0,0"
                               Text="{Binding Model.Settings.FocalLengthMm, StringFormat={}{0:0.0} mm}" />
                </Grid>
            </StackPanel>

            <cameras:PerspectiveCameraView IsVisible="{Binding IsPerspective}" />
            <cameras:OrthographicCameraView IsVisible="{Binding IsOrthographic}" />
            <cameras:FisheyeCameraView IsVisible="{Binding IsFisheye}" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
