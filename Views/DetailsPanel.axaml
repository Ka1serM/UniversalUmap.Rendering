<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:UniversalUmap.Rendering.ViewModels;assembly=UniversalUmap.Rendering"
             x:Class="UniversalUmap.Rendering.Views.DetailsPanel"
             x:DataType="viewModels:DetailsPanelViewModel"
             x:CompileBindings="False">
    <Grid>
        <TextBlock x:Name="PlaceholderText" Classes="renderLabel"
                   TextWrapping="Wrap"
                   Text="Select an object in the Outliner to view its details."
                   IsVisible="True" />
        <ScrollViewer x:Name="ScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      IsVisible="False">
            <StackPanel x:Name="Container" Spacing="10" />
        </ScrollViewer>
    </Grid>
</UserControl>
