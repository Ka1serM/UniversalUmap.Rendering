<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:rendering="clr-namespace:UniversalUmap.Rendering.Controls;assembly=UniversalUmap.Rendering"
             x:Class="UniversalUmap.Rendering.Views.ViewerPanel">
    <Border ClipToBounds="True">
        <Grid>
            <rendering:VulkanViewerControl x:Name="ViewportControl" />
            <rendering:EnvironmentRotationControl Source="{Binding ElementName=ViewportControl}" />
            <rendering:SunDirectionControl Source="{Binding ElementName=ViewportControl}" />
            <rendering:RotateViewGizmoControl Source="{Binding ElementName=ViewportControl}" />
            <rendering:DollyViewGizmoControl Source="{Binding ElementName=ViewportControl}" />
            <rendering:PanViewGizmoControl Source="{Binding ElementName=ViewportControl}" />
            <rendering:RenderModeSwitcher Margin="12"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Top"
                                          SelectedMode="{Binding RenderSettingsPanel.Model.RenderMode, Mode=TwoWay}" />
        </Grid>
    </Border>
</UserControl>
