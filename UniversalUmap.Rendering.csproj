<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>UniversalUmap.Rendering</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <UsedAvaloniaProducts></UsedAvaloniaProducts>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <AppendRuntimeIdentifierToOutputPath>true</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.12" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.12" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="FluentIcons.Avalonia.Fluent" Version="2.0.318" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
  </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\CUE4Parse\CUE4Parse\CUE4Parse.csproj" />
      <ProjectReference Include="..\CUE4Parse\CUE4Parse-Conversion\CUE4Parse-Conversion.csproj" />
    </ItemGroup>
  
  <ItemGroup>
    <None Include="Assets\Shaders\SharedStructs.Extras.h" />
    <ShaderInclude Include="$(ProjectDir)Assets\Shaders\**\*.glsl" />
    <ShaderInclude Include="$(ProjectDir)Assets\Shaders\**\*.h" />
    <ShaderInclude Include="$(ProjectDir)Assets\Shaders\**\*.comp" />

    <ShaderSource Include="$(ProjectDir)Assets/Shaders/RTX/RayGeneration.glsl"
                  Arguments="--target-env=vulkan1.3" />
    <ShaderSource Include="$(ProjectDir)Assets/Shaders/RTX/RayGenerationAo.glsl"
                  Arguments="--target-env=vulkan1.3" />
    <ShaderSource Include="$(ProjectDir)Assets/Shaders/RTX/RayGenerationDirect.glsl"
                  Arguments="--target-env=vulkan1.3" />

    <ShaderSource Include="$(ProjectDir)Assets/Shaders/RTX/ClosestHit.glsl"
                  Arguments="--target-env=vulkan1.3" />
    <ShaderSource Include="$(ProjectDir)Assets/Shaders/RTX/ClosestHitAo.glsl"
                  Arguments="--target-env=vulkan1.3" />
    <ShaderSource Include="$(ProjectDir)Assets/Shaders/RTX/ClosestHitDirect.glsl"
                  Arguments="--target-env=vulkan1.3" />

    <ShaderSource Include="$(ProjectDir)Assets/Shaders/RTX/Miss.glsl"
                  Arguments="--target-env=vulkan1.3" />
    <ShaderSource Include="$(ProjectDir)Assets/Shaders/RTX/MissAo.glsl"
                  Arguments="--target-env=vulkan1.3" />
    <ShaderSource Include="$(ProjectDir)Assets/Shaders/RTX/MissDirect.glsl"
                  Arguments="--target-env=vulkan1.3" />

    <ShaderSource Include="$(ProjectDir)Assets/Shaders/RTX/ShadowMiss.glsl"
                  Arguments="--target-env=vulkan1.3" />

    <ShaderSource Include="$(ProjectDir)Assets/Shaders/Compute/PathTracer.comp"
                  Arguments="-DUSE_COMPUTE=1" />
    <ShaderSource Include="$(ProjectDir)Assets/Shaders/Compute/PathTracerAo.comp"
                  Arguments="-DUSE_COMPUTE=1" />
    <ShaderSource Include="$(ProjectDir)Assets/Shaders/Compute/PathTracerDirect.comp"
                  Arguments="-DUSE_COMPUTE=1" />

    <ShaderSource Include="$(ProjectDir)Assets/Shaders/Compositing/OverlayComposite.comp" />

    <ShaderSource Include="$(ProjectDir)Assets/Shaders/Widgets/FullScreenTriVS.glsl"
                  Arguments="-fshader-stage=vert" />
    <ShaderSource Include="$(ProjectDir)Assets/Shaders/Widgets/SunDirectionWidgetFS.glsl"
                  Arguments="-fshader-stage=frag" />
    <ShaderSource Include="$(ProjectDir)Assets/Shaders/Widgets/EnvironmentRotationWidgetFS.glsl"
                  Arguments="-fshader-stage=frag" />
  </ItemGroup>

  <Target Name="CompileShaders"
          BeforeTargets="Build"
          Inputs="@(ShaderSource);@(ShaderInclude)"
          Outputs="@(ShaderSource->'%(RootDir)%(Directory)%(Filename).spv')">

    <Message Text="Compiling shaders via glslc..." Importance="High" />

    <Exec Command='glslc %(ShaderSource.Arguments) "%(ShaderSource.Identity)" -o "%(ShaderSource.RootDir)%(ShaderSource.Directory)%(ShaderSource.Filename).spv"'
          LogStandardErrorAsError="true" />

    <ItemGroup>
      <EmbeddedResource Include="@(ShaderSource->'%(RootDir)%(Directory)%(Filename).spv')"
                        Exclude="@(EmbeddedResource)" />
    </ItemGroup>
  </Target>

  <Target Name="GenerateSharedStructsHeader"
          BeforeTargets="CompileShaders"
          Inputs="$(ProjectDir)Assets\Shaders\SharedStructs.cs;$(ProjectDir)Assets\Shaders\SharedStructs.Extras.h;$(MSBuildProjectDirectory)\..\Tools\SharedStructsHeaderGen\Program.cs;$(MSBuildProjectDirectory)\..\Tools\SharedStructsHeaderGen\SharedStructsHeaderGen.csproj"
          Outputs="$(ProjectDir)Assets\Shaders\SharedStructs.h">
    <Message Text="Generating SharedStructs.h from Assets\Shaders\SharedStructs.cs..." Importance="High" />
    <Exec Command='dotnet run --project "$(MSBuildProjectDirectory)\..\Tools\SharedStructsHeaderGen\SharedStructsHeaderGen.csproj" -- "$(ProjectDir)Assets\Shaders\SharedStructs.cs" "$(ProjectDir)Assets\Shaders\SharedStructs.Extras.h" "$(ProjectDir)Assets\Shaders\SharedStructs.h"'
          LogStandardErrorAsError="true" />
  </Target>
  
  <ItemGroup>
    <EmbeddedResource Include="Assets\**" />
  </ItemGroup>
  
</Project>
