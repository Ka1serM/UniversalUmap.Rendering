<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>UniversalUmap.Rendering</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <UsedAvaloniaProducts></UsedAvaloniaProducts>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <AppendRuntimeIdentifierToOutputPath>true</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.12" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.12" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="FluentIcons.Avalonia.Fluent" Version="2.0.318" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CUE4Parse\CUE4Parse\CUE4Parse.csproj" />
    <ProjectReference Include="..\CUE4Parse\CUE4Parse-Conversion\CUE4Parse-Conversion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\Shaders\SharedStructs.Extras.h" />
    <ShaderInclude Include="$(ProjectDir)Assets\Shaders\**\*.glsl" />
    <ShaderInclude Include="$(ProjectDir)Assets\Shaders\**\*.h" />

    <!-- AO Pipeline - RTX -->
    <ShaderSource Include="$(ProjectDir)Assets/Shaders/AO/AoRaygen.glsl"
                  Arguments="--target-env=vulkan1.3"
                  OutputName="AoRaygen"
                  OutputSubDir="AO" />
    <ShaderSource Include="$(ProjectDir)Assets/Shaders/AO/AoClosesthit.glsl"
                  Arguments="--target-env=vulkan1.3"
                  OutputName="AoClosesthit"
                  OutputSubDir="AO" />
    <ShaderSource Include="$(ProjectDir)Assets/Shaders/AO/AoMiss.glsl"
                  Arguments="--target-env=vulkan1.3"
                  OutputName="AoMiss"
                  OutputSubDir="AO" />
    <ShaderSource Include="$(ProjectDir)Assets/Shaders/Common/ShadowMiss.glsl"
                  Arguments="--target-env=vulkan1.3"
                  OutputName="ShadowMiss"
                  OutputSubDir="Common" />

    <!-- AO Pipeline - Compute -->
    <ShaderSource Include="$(ProjectDir)Assets/Shaders/AO/AoPipeline.glsl"
                  Arguments="--target-env=vulkan1.3 -DUSE_COMPUTE"
                  OutputName="AoPipeline"
                  OutputSubDir="AO" />

    <!-- DirectLighting Pipeline - RTX -->
    <ShaderSource Include="$(ProjectDir)Assets/Shaders/DirectLighting/DirectLightingRaygen.glsl"
                  Arguments="--target-env=vulkan1.3"
                  OutputName="DirectLightingRaygen"
                  OutputSubDir="DirectLighting" />
    <ShaderSource Include="$(ProjectDir)Assets/Shaders/DirectLighting/DirectLightingClosesthit.glsl"
                  Arguments="--target-env=vulkan1.3"
                  OutputName="DirectLightingClosesthit"
                  OutputSubDir="DirectLighting" />
    <ShaderSource Include="$(ProjectDir)Assets/Shaders/DirectLighting/DirectLightingMiss.glsl"
                  Arguments="--target-env=vulkan1.3"
                  OutputName="DirectLightingMiss"
                  OutputSubDir="DirectLighting" />

    <!-- DirectLighting Pipeline - Compute -->
    <ShaderSource Include="$(ProjectDir)Assets/Shaders/DirectLighting/DirectLightingPipeline.glsl"
                  Arguments="--target-env=vulkan1.3 -DUSE_COMPUTE"
                  OutputName="DirectLightingPipeline"
                  OutputSubDir="DirectLighting" />

    <!-- PathTracing Pipeline - RTX -->
    <ShaderSource Include="$(ProjectDir)Assets/Shaders/PathTracing/PathTracingRaygen.glsl"
                  Arguments="--target-env=vulkan1.3"
                  OutputName="PathTracingRaygen"
                  OutputSubDir="PathTracing" />
    <ShaderSource Include="$(ProjectDir)Assets/Shaders/PathTracing/PathTracingClosesthit.glsl"
                  Arguments="--target-env=vulkan1.3"
                  OutputName="PathTracingClosesthit"
                  OutputSubDir="PathTracing" />
    <ShaderSource Include="$(ProjectDir)Assets/Shaders/PathTracing/PathTracingMiss.glsl"
                  Arguments="--target-env=vulkan1.3"
                  OutputName="PathTracingMiss"
                  OutputSubDir="PathTracing" />

    <!-- PathTracing Pipeline - Compute -->
    <ShaderSource Include="$(ProjectDir)Assets/Shaders/PathTracing/PathTracingPipeline.glsl"
                  Arguments="--target-env=vulkan1.3 -DUSE_COMPUTE"
                  OutputName="PathTracingPipeline"
                  OutputSubDir="PathTracing" />

    <ShaderSource Include="$(ProjectDir)Assets/Shaders/Compositing/Compositor.glsl"
                  Arguments="-fshader-stage=comp"
                  OutputName="Compositor"
                  OutputSubDir="Compositing" />

    <ShaderSource Include="$(ProjectDir)Assets/Shaders/Widgets/FullScreenTriVS.glsl"
                  Arguments="-fshader-stage=vert"
                  OutputName="FullScreenTriVS"
                  OutputSubDir="Widgets" />
    <ShaderSource Include="$(ProjectDir)Assets/Shaders/Widgets/SunDirectionWidgetFS.glsl"
                  Arguments="-fshader-stage=frag"
                  OutputName="SunDirectionWidgetFS"
                  OutputSubDir="Widgets" />
    <ShaderSource Include="$(ProjectDir)Assets/Shaders/Widgets/EnvironmentRotationWidgetFS.glsl"
                  Arguments="-fshader-stage=frag"
                  OutputName="EnvironmentRotationWidgetFS"
                  OutputSubDir="Widgets" />
  </ItemGroup>

  <Target Name="CompileShaders"
          BeforeTargets="Build"
          Inputs="@(ShaderSource);@(ShaderInclude)"
          Outputs="$(ProjectDir)Assets/Shaders/%(ShaderSource.OutputSubDir)/%(ShaderSource.OutputName).spv">

    <Message Text="Compiling shaders via glslc..." Importance="High" />

    <Exec Command='glslc %(ShaderSource.Arguments) "%(ShaderSource.Identity)" -o "$(ProjectDir)Assets/Shaders/%(ShaderSource.OutputSubDir)/%(ShaderSource.OutputName).spv"'
          LogStandardErrorAsError="true" />

    <ItemGroup>
      <EmbeddedResource Include="$(ProjectDir)Assets/Shaders/%(ShaderSource.OutputSubDir)/%(ShaderSource.OutputName).spv"
                        Exclude="@(EmbeddedResource)" />
    </ItemGroup>
  </Target>

  <Target Name="GenerateSharedStructsHeader"
          BeforeTargets="CompileShaders"
          Inputs="$(ProjectDir)Assets\Shaders\SharedStructs.cs;$(ProjectDir)Assets\Shaders\SharedStructs.Extras.h;$(MSBuildProjectDirectory)\..\Tools\SharedStructsHeaderGen\Program.cs;$(MSBuildProjectDirectory)\..\Tools\SharedStructsHeaderGen\SharedStructsHeaderGen.csproj"
          Outputs="$(ProjectDir)Assets\Shaders\SharedStructs.h">
    <Message Text="Generating SharedStructs.h from Assets\Shaders\SharedStructs.cs..." Importance="High" />
    <Exec Command='dotnet run --project "$(MSBuildProjectDirectory)\..\Tools\SharedStructsHeaderGen\SharedStructsHeaderGen.csproj" -- "$(ProjectDir)Assets\Shaders\SharedStructs.cs" "$(ProjectDir)Assets\Shaders\SharedStructs.Extras.h" "$(ProjectDir)Assets\Shaders\SharedStructs.h"'
          LogStandardErrorAsError="true" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Assets\**" />
  </ItemGroup>
</Project>
